# ==============================================================================
# Reflect Environment Variables & Secrets Reference
# DO NOT COMMIT REAL SECRETS TO THIS FILE OR TO SOURCE CONTROL.
# In GitHub, configure these in: Repository Settings -> Secrets and variables -> Actions
# In Google Cloud, configure in: Google Secret Manager (GSM) -> Cloud Run --set-secrets
# ==============================================================================

# --- SERVER-SIDE SECRETS (Never exposed to client / browser) ---
# GEMINI_API_KEY: Required for server-side Gemini AI API calls.
# Google Secret Manager Secret: GEMINI_API_KEY
# GitHub Secret Name: GEMINI_API_KEY
GEMINI_API_KEY=

# FIREBASE_APPLET_CONFIG: Full JSON string of firebase-applet-config.json
# Store this in Google Secret Manager under secret name: FIREBASE_APPLET_CONFIG
# Cloud Run will automatically parse and supply it to the server runtime.
FIREBASE_APPLET_CONFIG=

# Optional: Path if mounting Google Secret Manager secret as a file in Cloud Run
# e.g. --update-secrets=/secrets/firebase-applet-config.json=FIREBASE_APPLET_CONFIG:latest
FIREBASE_CONFIG_FILE=/secrets/firebase-applet-config.json

# Optional Google Secret Manager resource name if binding secrets in Cloud Run
GEMINI_SECRET_NAME=

# Google Cloud & Firebase project identifiers
GOOGLE_CLOUD_PROJECT=her-journel
FIREBASE_PROJECT_ID=her-journel

# APP_URL: The URL where this applet is hosted (e.g. Cloud Run URL)
APP_URL=

# --- CLIENT-SIDE FIREBASE CONFIGURATION (Injected via Vite / GitHub Secrets / GSM) ---
# VITE_FIREBASE_API_KEY / FIREBASE_API_KEY: The restricted Firebase / Google Web API Key.
# Google Secret Manager Secret: FIREBASE_API_KEY
# GitHub Secret Name: FIREBASE_API_KEY
VITE_FIREBASE_API_KEY=
FIREBASE_API_KEY=

# Client Project & Auth configuration (Non-sensitive public identifiers)
VITE_FIREBASE_PROJECT_ID=her-journel
VITE_FIREBASE_AUTH_DOMAIN=her-journel.firebaseapp.com
VITE_FIRESTORE_DATABASE_ID=ai-studio-reflect-86bb1722-fdae-4406-b5d8-592426ee33a5
VITE_FIREBASE_STORAGE_BUCKET=her-journel.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=556746620508
VITE_FIREBASE_APP_ID=1:556746620508:web:fd49e09bc95dc7ef5cf099
