# GEMINI_API_KEY: Required for server-side Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Optional Secret Manager secret resource name if resolving via Secret Manager in Cloud Run
GEMINI_SECRET_NAME=""

# Google Cloud & Firebase project identifiers
GOOGLE_CLOUD_PROJECT="her-journel"
FIREBASE_PROJECT_ID="her-journel"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

